<?xml version="1.0" encoding="UTF-8"?>
<!--
  gate-web: the Web operations console + agent session orchestration driver adapter
  (执行文档-后端-web §2). It is a driver adapter on the SAME level as gate-cli and must NOT
  depend on gate-cli (ArchUnit enforces this, §2.1). It depends on application + adapters +
  ports + domain, reusing GateService and the existing adapters wholesale.

  HTTP layer: Javalin 5.x over Jetty 11 (ADR-8 amendment). No Spring web. Spring is pulled
  transitively only for the adapter wiring (JdbcTemplate etc.). JSON is Jackson.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>gate</groupId>
    <artifactId>gate-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>gate-web</artifactId>
  <name>gate-web</name>

  <properties>
    <!--
      Javalin 5.6.3 requires Jetty 11 (MimeTypes.getInferredEncodings exists in 11.0.20 but NOT
      in Jetty 12.0.x). Spring Boot's dependencyManagement pins Jetty to 12.0.8, so every Jetty
      artifact used by Javalin is pinned explicitly here to keep a single consistent version.
    -->
    <jetty.version>11.0.20</jetty.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-application</artifactId>
    </dependency>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-adapters</artifactId>
    </dependency>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-bootstrap</artifactId>
    </dependency>

    <!-- Lightweight mature Web framework: Javalin 5.x over Jetty 11 (Jakarta). -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>5.6.3</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-http</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-util</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-io</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-webapp</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-servlet</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-security</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-xml</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>websocket-jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>websocket-jetty-api</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>websocket-jetty-common</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>websocket-servlet</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>websocket-core-common</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>websocket-core-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>

    <!-- Jackson (version managed by spring-boot-dependencies BOM: 2.15.4, consistent set). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Adapter wiring (SqliteDataSourceFactory, JdbcTemplate, TransactionTemplate) needs Spring
         JDBC on the classpath at runtime; the web layer itself uses none of it directly. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
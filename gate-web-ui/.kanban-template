<template>
  <div class="kanban-page">
    <section class="kanban-intro">
      <div class="kanban-intro__copy">
        <p class="kanban-eyebrow">WORK QUEUE / 08 STAGES</p>
        <h2>把复杂交付，拆成可见的下一步。</h2>
        <p class="kanban-intro__lede">
          每张工单都带着证据前进。拖动卡片更新阶段，点击卡片查看完整审计轨迹。
        </p>
      </div>
      <div class="kanban-intro__metric">
        <strong>{{ filteredTickets.length }}</strong>
        <span>VISIBLE TICKETS</span>
      </div>
    </section>

    <div class="kanban-toolbar">
      <div class="view-toggle" role="tablist" aria-label="视图切换">
        <button type="button" :class="{ active: view === 'board' }" :aria-selected="view === 'board'" @click="view = 'board'">看板</button>
        <button type="button" :class="{ active: view === 'list' }" :aria-selected="view === 'list'" @click="view = 'list'">列表</button>
      </div>
      <div class="toolbar-search">
        <GIcon name="search" :size="15" />
        <GInput v-model="search" placeholder="搜索工单、项目或标签" aria-label="搜索工单" />
        <button v-if="search" type="button" class="toolbar-search__clear" aria-label="清除搜索" @click="search = ''">×</button>
      </div>
      <span class="toolbar-count">{{ filteredTickets.length }} 条可见</span>
      <div class="spacer" />
      <GButton variant="primary" size="sm" @click="showCreate = true">
        <GIcon name="plus" :size="14" />
        新建工单
      </GButton>
    </div>

    <div v-if="view === 'board'" class="kanban">
      <div
        v-for="group in grouped"
        :key="group.col"
        class="kanban-col"
        :data-stage="group.col"
        @dragover.prevent
        @drop="onDrop($event, group.col)"
      >
        <div class="kanban-col__head">
          <div class="kanban-col__title">
            <i class="stage-mark" aria-hidden="true" />
            <span>{{ group.label }}</span>
          </div>
          <span class="kanban-col__count">{{ group.cards.length }}</span>
        </div>
        <div class="kanban-col__cards">
          <article
            v-for="t in group.cards"
            :key="t.no"
            class="issue-card"
            :class="{ 'issue-card--rejected': t.stage === 'REJECTED' }"
            draggable="true"
            tabindex="0"
            @dragstart="(e: DragEvent) => e.dataTransfer?.setData('text/plain', t.no)"
            @click="open(t.no)"
            @keydown.enter="open(t.no)"
          >
            <div class="issue-card__top">
              <span class="issue-card__key">{{ t.no }}</span>
              <div class="issue-card__top-right">
                <span v-if="t.priority" class="issue-card__priority" :class="'issue-card__priority--' + t.priority.toLowerCase()">{{ t.priority }}</span>
                <GBadge :tone="toneFor(t.stage)">{{ stageLabels[t.stage] }}</GBadge>
              </div>
            </div>

            <div class="issue-card__title">{{ t.title }}</div>

            <div v-if="t.project || t.dependencies?.length" class="issue-card__project">
              <GTooltip :content="'依赖项目: ' + (t.dependencies?.join(', ') || '无')">
                <span class="issue-card__project-link">
                  <GIcon name="folder" :size="12" />
                  {{ t.project }}
                </span>
              </GTooltip>
              <span v-if="t.dependencies?.length" class="issue-card__deps">
                <GIcon name="git-branch" :size="12" />
                {{ t.dependencies.length }}
              </span>
            </div>

            <div v-if="t.labels?.length" class="issue-card__labels">
              <span v-for="label in t.labels.slice(0, 2)" :key="label" class="issue-card__label">{{ label }}</span>
              <span v-if="(t.labels?.length ?? 0) > 2" class="issue-card__label-more">+{{ (t.labels?.length ?? 0) - 2 }}</span>
            </div>

            <div class="issue-card__bottom">
              <GTooltip :content="'执行者: ' + agentName(t)">
                <GAvatar :name="agentName(t)" :tone="t.agentConfigId ? 'accent' : 'neutral'" />
              </GTooltip>
              <span class="issue-card__assignee">{{ agentName(t) }}</span>
              <span v-if="t.reviewRound" class="issue-card__round">R{{ t.reviewRound }}</span>
              <span class="spacer" />
              <GTooltip :content="(t.commentCount ?? 0) + ' 条评论'">
                <span class="issue-card__comment"><GIcon name="comment" :size="12" />{{ t.commentCount ?? 0 }}</span>
              </GTooltip>
              <span class="issue-card__tokens mono">{{ t.execTokenTotal ?? '—' }}</span>
            </div>
          </article>
          <div v-if="group.cards.length === 0" class="kanban-col__empty">
            {{ search ? '没有匹配的工单' : '空' }}
          </div>
        </div>
      </div>
    </div>

    <div v-else class="list-panel">
      <div class="list-panel__head">
        <div>
          <span class="list-panel__title">全部工单</span>
          <span class="list-panel__sub">按最近更新排序</span>
        </div>
        <span class="list-panel__count">{{ filteredTickets.length }} 条</span>
      </div>
      <table class="g-table">
        <thead>
          <tr>
            <th>工单</th><th>标题</th><th>阶段</th><th>Round</th><th>Token</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="t in filteredTickets" :key="t.no" @click="open(t.no)">
            <td class="mono">{{ t.no }}</td>
            <td>{{ t.title }}</td>
            <td><GBadge :tone="toneFor(t.stage)">{{ stageLabels[t.stage] }}</GBadge></td>
            <td class="mono">{{ t.reviewRound ?? '—' }}</td>
            <td class="mono">{{ t.execTokenTotal ?? '—' }}</td>
          </tr>
          <tr v-if="filteredTickets.length === 0">
            <td colspan="5" class="g-table__empty">没有找到匹配的工单</td>
          </tr>
        </tbody>
      </table>
    </div>

    <GModal :show="showCreate" title="新建工单" width="460px" @close="showCreate = false">
      <div class="form">
        <label class="field">
          <span>工单号</span>
          <GInput v-model="newNo" />
        </label>
        <label class="field">
          <span>标题</span>
          <GInput v-model="newTitle" placeholder="例如：修复审核台锚定" />
        </label>
        <label class="field">
          <span>Agent 配置</span>
          <GSelect
            v-model="newAgent"
            :options="[
              { label: 'Claude Sonnet', value: 'claude-sonnet-default' },
              { label: 'OpenCode Default', value: 'opencode-default' },
            ]"
            placeholder="不使用 agent（人工）"
          />
        </label>
      </div>
      <template #footer>
        <GButton variant="ghost" @click="showCreate = false">取消</GButton>
        <GButton variant="primary" @click="create">创建</GButton>
      </template>
    </GModal>
  </div>
</template>
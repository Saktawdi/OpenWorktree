# 本地密钥模板 —— 复制为 .env 并填入真实值。.env 已在 .gitignore，不会被提交。
# 用途见 架构落地执行文档.md §10.1.1 / ADR-9：所有 LLM 经 newapi 网关中转，key 不进代码/argv/日志。
# P2 实现时由执行 agent 读取 .env，经环境变量 OPENAI_API_KEY 注入 prism 子进程。

# newapi 网关地址（OpenAI 兼容）。P2 默认就这一条 provider。
NEWAPI_BASE_URL=https://newapi.sakta.top/v1

# newapi 的 API key —— 请填这里
NEWAPI_API_KEY=

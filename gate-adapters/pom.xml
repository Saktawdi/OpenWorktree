<?xml version="1.0" encoding="UTF-8"?>
<!--
  gate-adapters: one technology per package, wired only through ports.
    git    -> real git binary via ProcessRunner (ADR-1: NO JGit)
    store  -> JdbcTemplate + TransactionTemplate + Flyway + SQLite (no JPA, §4.4)
    hook   -> pre-receive generator (LF, no BOM — N2)
    blob / audit / lock / clock / config
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>gate</groupId>
    <artifactId>gate-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>gate-adapters</artifactId>
  <name>gate-adapters</name>

  <dependencies>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>gate</groupId>
      <artifactId>gate-application</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
</project>
